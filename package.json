{
  "name": "oudguide-monorepo",
  "version": "4.0.0",
  "private": true,
  "description": "OudGuide.com — Fragrance Knowledge Portal, Directory, and Supplier Matching System",
  "scripts": {
    "dev": "pnpm --filter @oudguide/web dev",
    "build": "pnpm -r build",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.js",
    "test:policy": "node --test tests/lead-policy.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "validate:pack": "python3 reference/OudGuide_Developer_Build_Pack_v3/engineering/validate_pack.py"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@next/swc-darwin-arm64"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}